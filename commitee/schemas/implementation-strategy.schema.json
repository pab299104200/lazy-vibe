{
  "type": "object",
  "additionalProperties": true,
  "required": [
    "lead_role",
    "provider",
    "lead_model",
    "max_subagents",
    "allow_parallel_subagents",
    "allowed_subagent_roles",
    "write_policy",
    "model_routing",
    "task_plan",
    "remote_log_plan",
    "budget"
  ],
  "properties": {
    "lead_role": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "lead_model": {
      "type": "string"
    },
    "max_subagents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "allow_parallel_subagents": {
      "type": "boolean"
    },
    "allowed_subagent_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "model_routing": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "task_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "task_id",
          "objective",
          "task_class",
          "effort_estimate",
          "risk_class",
          "recommended_model_profile",
          "context_budget_tokens",
          "subagent_suitable",
          "expected_files_or_subsystems",
          "dependencies",
          "required_tests",
          "required_docs"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "task_class": {
            "type": "string",
            "enum": [
              "code_search",
              "docs",
              "mechanical_edits",
              "normal_implementation",
              "test_generation",
              "architecture_sensitive_code",
              "security_or_tenancy_review",
              "schema_or_migration",
              "review",
              "audit_evidence"
            ]
          },
          "effort_estimate": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large",
              "xlarge"
            ]
          },
          "risk_class": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "recommended_model_profile": {
            "type": "string",
            "enum": [
              "cheap_fast",
              "balanced",
              "deep"
            ]
          },
          "context_budget_tokens": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 200000
          },
          "subagent_suitable": {
            "type": "boolean"
          },
          "expected_files_or_subsystems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_docs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "remote_log_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reason",
        "sources_to_check"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "sources_to_check": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
