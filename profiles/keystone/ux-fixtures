#!/usr/bin/env bash
set -euo pipefail

action="${1:?missing action}"
repo_root="${2:?missing repo root}"
run_dir="${3:?missing run dir}"
plan_file="${4:?missing plan file}"
manifest_file="${5:?missing manifest file}"
fixture_dir="$run_dir/artifacts/ux-fixtures"
upload_file="$fixture_dir/keystone-audit-evidence.txt"

case "$action" in
  prepare)
    mkdir -p "$fixture_dir"
    printf 'Keystone UX audit evidence fixture\nRun: %s\n' "$(basename "$run_dir")" > "$upload_file"
    cat > "$manifest_file" <<MANIFEST
# UX Fixture Manifest

STATUS: PARTIAL

## Available Capabilities

- \`file_upload\`: READY
  - Disposable file: \`$upload_file\`
  - Cleanup owner: harness provider
  - Use the Playwright file-upload tool, not drag-and-drop.
- \`browser_record_creation\`: READY
  - Create uniquely prefixed reversible Keystone records through the deployed UI using Playwright typing/fill tools.

## Portal Provisioning Capabilities

- \`fresh_portal_tenant\`: READY
  - Portal URL: \`https://portal-dev.cadres.io\`
  - The audit identity is an operator super-user with \`portal.tenant.manage\`.
  - Create only uniquely prefixed disposable tenants through the Portal UI and record cleanup ownership.
- \`disposable_portal_identities\`: READY
  - The audit identity has \`portal.users.manage\` and \`portal.groups.manage\`.
  - Create only uniquely prefixed users and groups inside the disposable audit tenant.
- \`portal_roles_manage\`: UNAVAILABLE
  - Reuse published roles rather than creating or changing Portal roles.

Never alter existing tenants, identities, groups, memberships, or grants. Portal provisioning prepares starting state; the Keystone browser journey must still prove bootstrap and scoped-access outcomes.
MANIFEST
    ;;
  cleanup)
    rm -f "$upload_file"
    ;;
  *)
    printf 'unknown fixture-provider action: %s\n' "$action" >&2
    exit 2
    ;;
esac
