#!/usr/bin/env bash
set -euo pipefail

action="${1:?missing action}"
repo_root="${2:?missing repo root}"
run_dir="${3:?missing run dir}"
plan_file="${4:-}"
manifest_file="${5:?missing manifest file}"
fixture_dir="$run_dir/artifacts/ux-fixtures"
upload_file="$fixture_dir/keystone-audit-evidence.png"
bank_csv_file="$fixture_dir/keystone-audit-bank-statement.csv"
bank_ofx_file="$fixture_dir/keystone-audit-bank-statement.ofx"
workspace_provider="$repo_root/scripts/ux_audit_fixture_provider.py"
workspace_prepared="$fixture_dir/keystone-prepared-fixtures.json"
fixture_key="$(basename "$run_dir" | tr -cd '[:alnum:]_-')"
actor_lanes_file="$fixture_dir/actor-lanes.tsv"

case "$action" in
  describe|prepare)
    mkdir -p "$fixture_dir"
    cat > "$actor_lanes_file" <<'ACTORS'
execution_job	default_actor	additional_actors
03-primary-work	tenant_admin	approver
03-exceptions	tenant_admin	requester,approver
03-administration	tenant_admin	requester,approver,reviewer,observer,operator,guest
ACTORS
    printf '%s' 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=' | base64 -d > "$upload_file"
    cat > "$bank_csv_file" <<CSV
date,description,amount
2026-07-01,UXAUDIT ${fixture_key} opening deposit,125.00
2026-07-02,UXAUDIT ${fixture_key} bank fee,-5.00
CSV
    cat > "$bank_ofx_file" <<OFX
OFXHEADER:100
DATA:OFXSGML
VERSION:102
SECURITY:NONE
ENCODING:USASCII
CHARSET:1252
COMPRESSION:NONE
OLDFILEUID:NONE
NEWFILEUID:NONE

<OFX><BANKMSGSRSV1><STMTTRNRS><TRNUID>UXAUDIT-${fixture_key}</TRNUID><STATUS><CODE>0</CODE><SEVERITY>INFO</SEVERITY></STATUS><STMTRS><CURDEF>USD</CURDEF><BANKACCTFROM><BANKID>000000001</BANKID><ACCTID>UXAUDIT-DISPOSABLE</ACCTID><ACCTTYPE>CHECKING</ACCTTYPE></BANKACCTFROM><BANKTRANLIST><DTSTART>20260701000000</DTSTART><DTEND>20260731235959</DTEND><STMTTRN><TRNTYPE>CREDIT</TRNTYPE><DTPOSTED>20260701120000</DTPOSTED><TRNAMT>125.00</TRNAMT><FITID>UXAUDIT-DEP-${fixture_key}</FITID><NAME>UXAUDIT ${fixture_key} opening deposit</NAME></STMTTRN><STMTTRN><TRNTYPE>FEE</TRNTYPE><DTPOSTED>20260702120000</DTPOSTED><TRNAMT>-5.00</TRNAMT><FITID>UXAUDIT-FEE-${fixture_key}</FITID><NAME>UXAUDIT ${fixture_key} bank fee</NAME></STMTTRN></BANKTRANLIST><LEDGERBAL><BALAMT>120.00</BALAMT><DTASOF>20260731235959</DTASOF></LEDGERBAL></STMTRS></STMTTRNRS></BANKMSGSRSV1></OFX>
OFX
    cat > "$manifest_file" <<MANIFEST
# UX Fixture Manifest

STATUS: PARTIAL

## Available Capabilities

- \`file_upload\`: READY
  - Disposable file: \`$upload_file\`
  - Cleanup owner: harness provider
  - Use the Playwright file-upload tool, not drag-and-drop. If the file-chooser tool times out, use Playwright run-code to call \`setInputFiles\` on the visible \`input[type=file]\`, then verify the selected filename before submitting.
  - Choose the recipient class that matches the required attachment: customer-facing for customer/invoice, vendor-facing for vendor/bill/purchase order, and internal evidence for expense/journal entry. Do not use an existing document with a different recipient class as a substitute.
- \`browser_record_creation\`: READY
  - Create uniquely prefixed reversible Keystone records through the deployed UI using Playwright typing/fill tools.
  - Use syntactically and semantically valid non-live fixture values. For email fields use a unique address at \`example.com\`; do not use reserved TLDs such as \`.test\` because application email validators may correctly reject them.
- \`purchase_to_pay_browser_setup\`: READY
  - No purchase order, receipt, bill, or match record is pre-created by the provider. Do not claim the provider completed this prerequisite.
  - Compose \`browser_record_creation\` with \`playwright_secondary\`: the primary actor creates and submits a uniquely prefixed purchase order, the secondary actor approves it, then the primary actor records the goods receipt and creates the PO-linked bill.
  - Complete the prerequisite workflow through the deployed UI; do not inject database records or treat setup actions as journey evidence.

- bank_statement_csv: READY
  - Disposable file: $bank_csv_file
  - Contains two uniquely named UXAUDIT transactions totaling USD 120.00.
  - Cleanup owner: harness provider and disposable tenant teardown.
- bank_statement_ofx: READY
  - Disposable file: $bank_ofx_file
  - Contains the same two deterministic UXAUDIT transactions with FITIDs stable within this run and unique across audit runs.
  - Cleanup owner: harness provider and disposable tenant teardown.

## Workspace Provisioning Capabilities

- \`fresh_keystone_customer_workspace\`: $([[ -x "$workspace_provider" ]] && printf READY_AFTER_PREPARE || printf UNAVAILABLE)
  - The provider composes Portal's disposable customer-tenant fixture with a Cadres commercial-control customer, current sold contract for \`product_key=keystone\`, and active \`portal-tenant:{id}\` binding.
  - Customer actors authenticate into the isolated customer-owned Keystone workspace. The Cadres operator remains in the separate commercial-control workspace.
- \`disposable_portal_identities\`: $([[ -x "$workspace_provider" ]] && printf READY_AFTER_PREPARE || printf UNAVAILABLE)
  - Prepared tenant-admin, requester, approver, reviewer, and observer browser states are scoped to the isolated Keystone customer workspace.
- \`secondary_keystone_approver\`: $([[ -x "$workspace_provider" ]] && printf READY_AFTER_PREPARE || printf UNAVAILABLE)
  - The provider creates a distinct approver in the disposable Portal tenant, assigns the Keystone application, authenticates the customer workspace, and grants the published tenant-wide \`keystone_accountant\` role before parallel execution lanes start.
  - Fixture preparation verifies the actual route authority needed for purchase-order, expense, journal, bank, and close decisions. Journeys must still prove visible access and successful maker-checker behavior; the fixture grant itself is not journey evidence.
  - The grant is tenant-wide because these disposable approval records are tenant-owned. Entity-scoped grants must be used only for records and routes that enforce the same entity authority.
  - Preserve the prepared grant until every dependent approver journey has completed. Cleanup retires it with the disposable customer workspace.
  - Do not use two sessions for the primary identity as approval evidence; actor IDs must differ.
- \`portal_roles_manage\`: UNAVAILABLE
  - Reuse published roles rather than creating or changing Portal roles.

Never alter existing tenants, identities, groups, memberships, or grants. Fixture setup must preserve the separation between Cadres commercial authority and the customer-owned Keystone data plane; the browser journey must still prove bootstrap and scoped-access outcomes.
MANIFEST
    if [[ "$action" == "prepare" && -x "$workspace_provider" ]]; then
      provider_action=prepare
      if [[ -s "$fixture_dir/private-fixtures.json" ]]; then
        provider_action=resume
      fi
      python3 "$workspace_provider" "$provider_action" "$repo_root" "$run_dir" "$fixture_key"
      python3 - "$workspace_prepared" "$manifest_file" "$upload_file" "$bank_csv_file" "$bank_ofx_file" <<'PY'
import json
import sys
from pathlib import Path

prepared = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
manifest = Path(sys.argv[2])
upload_file, bank_csv_file, bank_ofx_file = sys.argv[3:]
if prepared.get("status") == "blocked":
    cleanup_complete = prepared.get("cleanup_complete") is True
    if cleanup_complete:
        cleanup_detail = "The provider retired any attempted Keystone contract and binding and archived the disposable Portal tenant."
    else:
        errors = "; ".join(prepared.get("cleanup_errors", [])) or "unspecified cleanup failure"
        cleanup_detail = f"Automatic cleanup did not complete ({errors}); private recovery state was retained and the cleanup action must be rerun."
    manifest.write_text(f"""# UX Fixture Manifest

STATUS: PARTIAL

## Workspace provisioning

- `fresh_keystone_customer_workspace`: BLOCKED
  - {prepared['reason']}
  - {cleanup_detail}
  - No unsupported application instance or customer workspace was fabricated.
- `disposable_portal_identities`: BLOCKED
  - Customer-workspace browser states cannot be issued until the reported fixture capability is restored.
- `authenticated_commercial_control_operator`: READY
  - The browser preflight state remains the Cadres commercial-control operator authority.

## Workflow artifacts

- `file_upload`: READY
  - Disposable file: `{upload_file}`
- `bank_statement_csv`: READY
  - Disposable file: `{bank_csv_file}`
- `bank_statement_ofx`: READY
  - Disposable file: `{bank_ofx_file}`
- `browser_record_creation`: READY_IN_COMMERCIAL_CONTROL_ONLY
  - Do not claim customer-workspace or first-login evidence from the control tenant.

Journey planning must mark first-workspace and customer-tenant journeys BLOCKED without failing unrelated commercial-control journeys. Never substitute a Portal-only tenant or a tenant-local Keystone subscription.
""", encoding="utf-8")
    raise SystemExit(0)
states = prepared["actor_states"]
keystone = prepared["keystone"]
manifest.write_text(f"""# UX Fixture Manifest

STATUS: READY

## Isolated Keystone customer workspace

- `fresh_keystone_customer_workspace`: READY
  - Portal tenant id: {prepared['target_tenant_id']}
  - Portal tenant slug: `{prepared['target_tenant_slug']}`
  - Cadres commercial customer id: {keystone['customer_id']}
  - Keystone sold contract id: {keystone['sold_contract_id']}
  - Keystone customer binding id: {keystone['binding_id']}
  - Authority remains the Cadres commercial-control tenant; the customer workspace contains no Cadres catalogue, customer, subscription, contract, or integration credential rows.
- `disposable_portal_identities`: READY
  - Tenant administrator state: `{states['tenant_admin']}`
  - Requester state: `{states['requester']}`
  - Approver state: `{states['approver']}`
  - Reviewer state: `{states['reviewer']}`
  - Observer state: `{states['observer']}`
  - Cadres operator state: `{states['operator']}`
  - Customer actors enter the isolated Keystone workspace; the operator state remains in the separate Cadres control workspace.

## Workflow artifacts

- `file_upload`: READY
  - Disposable file: `{upload_file}`
- `bank_statement_csv`: READY
  - Disposable file: `{bank_csv_file}`
- `bank_statement_ofx`: READY
  - Disposable file: `{bank_ofx_file}`
- `browser_record_creation`: READY
  - Create only uniquely prefixed reversible records in the disposable customer workspace.
- `purchase_to_pay_browser_setup`: READY
  - No purchase order, receipt, bill, or match record is pre-created by the provider. The execution lane must complete the setup before it evaluates review or matching behavior.
  - Create the uniquely prefixed vendor, purchase order, receipt, and linked bill through visible Keystone controls in the disposable workspace.
  - Use the prepared approver actor for maker-checker approval; setup completion alone is not journey evidence.
- `secondary_keystone_approver`: READY
  - Use the distinct prepared approver state; never reuse the primary actor as approval evidence.

## Safety and cleanup

- Fixture preparation is infrastructure, not browser-journey evidence.
- Cleanup immediately cancels the disposable Keystone contract, archives its customer binding, and archives the Portal tenant through supported APIs. Historical sold-contract truth remains retained for financial auditability.
- Never expose private fixture files, cookies, credentials, or tokens in prompts or evidence.
""", encoding="utf-8")
PY
    fi
    ;;
  cleanup)
    if [[ -x "$workspace_provider" ]]; then
      python3 "$workspace_provider" cleanup "$repo_root" "$run_dir" "$fixture_key"
    fi
    rm -f "$upload_file" "$bank_csv_file" "$bank_ofx_file"
    rm -f "$fixture_dir"/auth-state-*.json "$fixture_dir"/init-page-*.ts
    rm -f "$actor_lanes_file"
    rm -f "$fixture_dir/private-fixtures.json" "$workspace_prepared" "$fixture_dir/prepared-fixtures.json"
    ;;
  *)
    printf 'unknown fixture-provider action: %s\n' "$action" >&2
    exit 2
    ;;
esac
